<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <!-- Android 13+ themed icons: the launcher recolours this layer to the
         user's wallpaper palette, so it takes the foreground as-is. The mark
         is a single flat colour over transparency, which is exactly the shape
         a monochrome layer wants; only the background is dropped. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
