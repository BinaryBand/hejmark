# This is the framework's curated ignore list: the stack produces a known,
# closed set of artifacts, so every entry below is justified and anchored (no
# unanchored patterns that could silently swallow a project source directory).

# Python bytecode
__pycache__/
*.py[cod]

# In-project virtualenv (uv creates .venv/ here)
.venv/

# Tool caches
.pytest_cache/
.ruff_cache/
.hypothesis/
.import_linter_cache/

# Build artifacts
/dist/
*.egg-info/

# Generated ANTLR parser (regenerate with `hejmark gen-parser`)
hejmark/adapters/_gen/

# Lean/Lake build artifacts (static/lean/)
static/lean/.lake/
static/lean/build/

# Rust build artifacts (rust/)
/rust/target/

# Local environment
.env

# Private project files (never committed)
.vscode/
editors/
docs/**/.*
static/**/.*

CLAUDE.md
.claude
