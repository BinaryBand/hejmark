// Replace `cat` only as a whole word. Mask every word between two
// sentinels, then rewrite the masked target -- the sentinels clear at
// exit, so `cat` inside `catalog` is never touched.
sentinel start
sentinel end
uni c = {a..z}
uni word = {@c,&@c}
{@word} => "{{@start}}{{$}}{{@end}}"
{@start}{cat}{@end} => "feline"
